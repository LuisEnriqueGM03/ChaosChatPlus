{
	"schemaVersion": 1,
	"id": "chaoschatplus",
	"version": "${version}",
	"name": "Chaos ChatPlus",
	"description": "Chat moderno para servidor y clientes Fabric: emojis, GIFs, mostrar ítems, menciones y capturas con moderación opcional. Integración opcional con Chaos Ranks.",
	"authors": [
		"Luis Enrique Gil Mayser"
	],
	"license": "MIT",
	"icon": "assets/chaoschatplus/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.chaos.chatplus.fabric.FabricBootstrap"
		],
		"client": [
			"com.chaos.chatplus.fabric.FabricClientBootstrap"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"chaosranks": "*"
	},
	"mixins": [
		"chaoschatplus.mixins.json"
	]
}
